      "name": "Recordings",
      "description": {
        "content": "Operations for managing call recordings and media",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "0ce2ee68-e294-438d-a598-eb5aaf6b329f",
          "name": "Gong Add call media recording",
          "request": {
            "name": "Gong Add call media recording",
            "description": {
              "content": "Adds call media (audio or video recording) to a previously created call. Gong accepts recordings in WAV, MP3, MP4, MKV, and FLAC formats up to 1.5GB in size.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "calls",
                ":id",
                "media"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "id",
                  "description": "(Required) The callId returned from the Add New Call request."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "PUT",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "mediaFile",
                  "type": "file",
                  "description": "(Required) The audio or video file to upload. Supported formats include WAV, MP3, MP4, MKV, and FLAC. Maximum size is 1.5GB."
                }
              ]
            }
          },
