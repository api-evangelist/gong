          "name": "Gong Override flow content",
          "request": {
            "name": "Gong Override flow content",
            "description": {
              "content": "Overrides the content of specific steps in an Engage flow to tailor messaging for specific campaigns or workflows. Allows customizing email subjects, bodies, and other step content.",
              "type": "text/plain"
            },
